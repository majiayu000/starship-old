    "explanation": [
      {
        "type": "string",
        "content": "Choice C is correct. It's given from the graph that the points",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(0 , 7\\right)"
        }
      },
      {
        "type": "string",
        "content": "and",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(8 , 0\\right)"
        }
      },
      {
        "type": "string",
        "content": "lie on the line. For two points on a line,",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(x_{1} , y_{1}\\right)"
        }
      },
      {
        "type": "string",
        "content": "and",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(x_{2} , y_{2}\\right)"
        }
      },
      {
        "type": "string",
        "content": ", the slope of the line can be calculated using the slope formula",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "m = \\frac{y_{2} - y_{1}}{x_{2} - x_{1}}"
        }
      },
      {
        "type": "string",
        "content": ". Substituting",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(0 , 7\\right)"
        }
      },
      {
        "type": "string",
        "content": "for",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(x_{1} , y_{1}\\right)"
        }
      },
      {
        "type": "string",
        "content": "and",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(8 , 0\\right)"
        }
      },
      {
        "type": "string",
        "content": "for",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(x_{2} , y_{2}\\right)"
        }
      },
      {
        "type": "string",
        "content": "in this formula, the slope of the line can be calculated as",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "m = \\frac{0 - 7}{8 - 0}"
        }
      },
      {
        "type": "string",
        "content": ", or",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "m = - \\frac{7}{8}"
        }
      },
      {
        "type": "string",
        "content": ". It's also given that the point",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(d , 4\\right)"
        }
      },
      {
        "type": "string",
        "content": "lies on the line. Substituting",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(d , 4\\right)"
        }
      },
      {
        "type": "string",
        "content": "for",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(x_{1} , y_{1}\\right)"
        }
      },
      {
        "type": "string",
        "content": ",",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(8 , 0\\right)"
        }
      },
      {
        "type": "string",
        "content": "for",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(x_{2} , y_{2}\\right)"
        }
      },
      {
        "type": "string",
        "content": ", and",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "- \\frac{7}{8}"
        }
      },
      {
        "type": "string",
        "content": "for",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "m"
        }
      },
      {
        "type": "string",
        "content": "in the slope formula yields",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "- \\frac{7}{8} = \\frac{0 - 4}{8 - d}"
        }
      },
      {
        "type": "string",
        "content": ", or",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "- \\frac{7}{8} = \\frac{- 4}{8 - d}"
        }
      },
      {
        "type": "string",
        "content": ". Multiplying both sides of this equation by",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "8 - d"
        }
      },
      {
        "type": "string",
        "content": "yields",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "- \\frac{7}{8} \\left(8 - d\\right) = - 4"
        }
      },
      {
        "type": "string",
        "content": ". Expanding the left-hand side of this equation yields",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "- 7 + \\frac{7}{8} d = - 4"
        }
      },
      {
        "type": "string",
        "content": ". Adding",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "7"
        }
      },
      {
        "type": "string",
        "content": "to both sides of this equation yields",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\frac{7}{8} d = 3"
        }
      },
      {
        "type": "string",
        "content": ". Multiplying both sides of this equation by",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\frac{8}{7}"
        }
      },
      {
        "type": "string",
        "content": "yields",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "d = \\frac{24}{7}"
        }
      },
      {
        "type": "string",
        "content": ". Thus, the value of",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "d"
        }
      },
      {
        "type": "string",
        "content": "is",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\frac{24}{7}"
        }
      },
      {
        "type": "string",
        "content": ".",
        "metadata": {
          "style": [
            "p"
          ]
        }
      },
      {
        "type": "string",
        "content": "Choice A is incorrect. This is the value of",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "y"
        }
      },
      {
        "type": "string",
        "content": "when",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "x = 4"
        }
      },
      {
        "type": "string",
        "content": ".",
        "metadata": {
          "style": [
            "p"
          ]
        }
      },
      {
        "type": "string",
        "content": "Choice B is incorrect and may result from conceptual or calculation errors.",
        "metadata": {
