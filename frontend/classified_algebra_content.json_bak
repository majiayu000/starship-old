          ],
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "= 26,000 represents this situation. The sales price of each glove is how many dollars less than the sales price of each bat?",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "blank"
