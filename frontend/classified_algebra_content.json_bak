          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\frac{16}{17}"
        }
      },
      {
        "type": "string",
        "content": ". It's given that the equation",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "3 \\left(k x + 13\\right) = \\frac{48}{17} x + 36"
        }
      },
      {
        "type": "string",
        "content": "has no solution. A linear equation in the form",
        "metadata": {
