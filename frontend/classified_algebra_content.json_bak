  {
    "url": "https://oneprep.xyz/question/5651/?question_set=princeton-review-practice-tests-question-bank&module=math&primary_class=Algebra&skill=Functions",
    "question_set": "princeton-review-practice-tests-question-bank",
    "subject": "Math",
    "difficulty": "",
    "domain": "Algebra",
    "skill": "Functions",
    "question_type": "select",
    "question_content": [
      {
        "type": "string",
        "content": "A rower crosses a lake with a width of 1.2 miles while rowing directly from one shore to another at a constant rate of 5 miles per hour. Which of the following function types best represents the relationship between the rower’s distance from the starting shore the time rowed?",
        "metadata": {
          "style": [
            "p"
          ],
          "content_type": "stem"
        }
      }
    ],
    "explanation": [
      {
        "type": "string",
        "content": "The question asks for a description of a function that models a specific situation. Compare the answer choices. Two choices say the function is increasing, and two say it is decreasing. Since the rower is crossing the lake directly, the distance between the rower and the starting shore is increasing over time. Eliminate (A) and (B) because they describe a decreasing function. The difference between (C) and (D) is whether the function is linear or exponential. Since the rower rows at a constant rate, the distance between the rower and the starting shore changes by a constant amount during each unit of time. Thus, the relationship between the rower’s distance from the starting shore and the time rowed is linear. Eliminate (C) because it describes an exponential function. The correct answer is (D).",
        "metadata": {
          "style": []
        }
      }
    ],
    "answer": {
      "identifier": "D",
      "is_correct": true,
      "content": [
        {
          "type": "string",
          "content": "Increasing linear",
          "metadata": {
            "style": []
          }
        }
      ]
    },
    "options": [
      {
        "identifier": "A",
        "is_correct": false,
        "content": [
          {
            "type": "string",
            "content": "Decreasing exponential",
            "metadata": {
              "style": []
            }
          }
        ]
      },
      {
        "identifier": "B",
        "is_correct": false,
        "content": [
          {
            "type": "string",
            "content": "Decreasing linear",
            "metadata": {
              "style": []
            }
          }
        ]
      },
      {
        "identifier": "C",
        "is_correct": false,
        "content": [
          {
            "type": "string",
            "content": "Increasing exponential",
            "metadata": {
              "style": []
            }
          }
        ]
      },
      {
        "identifier": "D",
        "is_correct": true,
        "content": [
          {
            "type": "string",
            "content": "Increasing linear",
            "metadata": {
              "style": []
            }
          }
        ]
      }
    ],
    "question_id": "5651",
    "knowledge_point": "Linear function word problems"
  },
