          "type": "latex",
          "content": "\\left(3 , 4\\right)"
        }
      },
      {
        "type": "string",
        "content": "is the solution to the system.",
        "metadata": {
          "style": [
            "p"
          ]
        }
      },
      {
        "type": "string",
        "content": "Choice A is incorrect. The point",
