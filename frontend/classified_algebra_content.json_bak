        "type": "formula",
        "content": {
          "type": "latex",
          "content": "b"
        }
      },
      {
        "type": "string",
        "content": "that make the system of equations true. Multiplying both sides of the equation for store A by",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "6.5"
        }
