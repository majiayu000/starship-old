    "question_content": [
      {
        "type": "string",
        "content": "Vivian bought party hats and cupcakes for",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\$ 71"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": ". Each package of party hats cost",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\$ 3"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": ", and each cupcake cost",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
