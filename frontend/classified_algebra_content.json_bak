  {
    "url": "https://oneprep.xyz/question/302/?question_set=college-board-question-bank&module=math&primary_class=H&skill=H.D.",
    "question_set": "college-board-question-bank",
    "subject": "Math",
    "difficulty": "Hard",
    "domain": "Algebra",
    "skill": "Systems of two linear equations in two variables",
    "question_type": "select",
    "question_content": [
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "y = 6 x + 18"
        },
        "metadata": {
          "style": [
            "p"
          ],
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "One of the equations in a system of two linear equations is given. The system has no solution. Which equation could be the second equation in the system?",
        "metadata": {
          "style": [
            "p"
          ],
          "content_type": "stem"
        }
      }
    ],
    "explanation": [
      {
        "type": "string",
        "content": "Choice B is correct. A system of two linear equations in two variables,",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "x"
        }
      },
      {
        "type": "string",
        "content": "and",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "y"
        }
      },
      {
        "type": "string",
        "content": ", has no solution if the lines represented by the equations in the",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "xy",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "-plane are parallel and distinct. Lines represented by equations in standard form,",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "A x + B y = C"
        }
      },
      {
        "type": "string",
        "content": "and",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "D x + E y = F"
        }
      },
      {
        "type": "string",
        "content": ", are parallel if the coefficients for",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "x"
        }
      },
      {
        "type": "string",
        "content": "and",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "y"
        }
      },
      {
        "type": "string",
        "content": "in one equation are proportional to the corresponding coefficients in the other equation, meaning",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\frac{D}{A} = \\frac{E}{B}"
        }
      },
      {
        "type": "string",
        "content": "; and the lines are distinct if the constants are not proportional, meaning",
        "metadata": {
          "style": []
        }
      },
