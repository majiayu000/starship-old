  {
    "url": "https://oneprep.xyz/question/11554/?question_set=college-board-question-bank&module=math&primary_class=H&skill=H.E.",
    "question_set": "college-board-question-bank",
    "subject": "Math",
    "difficulty": "Easy",
    "domain": "Algebra",
    "skill": "Linear inequalities in one or two variables",
    "question_type": "fill",
    "question_content": [
      {
        "type": "string",
        "content": "For a party,",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "50"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "dinner rolls are needed. Dinner rolls are sold in packages of",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "12"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": ". What is the minimum number of packages that should be bought for the party?",
        "metadata": {
          "style": [
            "p"
          ],
          "content_type": "stem"
        }
      },
      {
        "type": "blank"
      }
    ],
    "explanation": [
      {
        "type": "string",
        "content": "The correct answer is",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "5"
        }
      },
      {
        "type": "string",
        "content": ". Let",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "p"
        }
      },
      {
        "type": "string",
        "content": "represent the number of packages of dinner rolls that should be bought for the party. It's given that dinner rolls are sold in packages of",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "12"
        }
      },
      {
        "type": "string",
        "content": ". Therefore,",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "12 p"
        }
      },
      {
        "type": "string",
        "content": "represents the number of dinner rolls that should be bought for the party. It's also given that",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "50"
        }
      },
      {
        "type": "string",
        "content": "dinner rolls are needed; therefore,",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "12 p \\geq 50"
        }
      },
      {
        "type": "string",
        "content": ". Dividing both sides of this inequality by",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "12"
        }
      },
      {
        "type": "string",
        "content": "yields",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "p \\geq \\frac{50}{12}"
        }
      },
      {
        "type": "string",
        "content": ", or approximately",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "p \\geq 4.17"
        }
      },
      {
        "type": "string",
        "content": ". Since the number of packages of dinner rolls must be a whole number, the minimum number of packages that should be bought for the party is",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "5"
        }
      },
      {
        "type": "string",
        "content": ".",
        "metadata": {
          "style": [
            "p"
          ]
        }
      }
    ],
    "answer": "5",
    "options": [],
    "question_id": "11554",
    "knowledge_point": "Linear inequalities with preserving operations"
  },
