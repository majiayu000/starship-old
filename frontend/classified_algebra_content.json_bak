        }
      }
    ],
    "explanation": [
      {
        "type": "string",
        "content": "Choice B is correct. Two lines are perpendicular if their slopes are negative reciprocals, meaning that the slope of the first line is equal to",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "- 1"
        }
      },
      {
        "type": "string",
        "content": "divided by the slope of the second line. Each equation in the given pair of equations can be written in slope-intercept form,",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "y = m x + b"
        }
