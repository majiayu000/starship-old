      {
        "type": "string",
        "content": "x",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "to both sides of the second equation to get 20",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "x",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "– 45",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "y",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "= 1. Add 45",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "y",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "to both sides of the second equation to get 20",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "x",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "= 45",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "y",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "+ 1, and then subtract 1 from both sides of the second equation to get 20",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "x",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "– 1 = 45",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "y",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": ". Next, multiply both sides of the first equation by 5 to get 20",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "x",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "– 1 = 15",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "ky",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": ". Write the two equations above each other to see how the terms match up.",
        "metadata": {
          "style": [
            "p"
          ]
        }
      },
      {
        "type": "string",
        "content": "20",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "x",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "– 1 = 15",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "ky",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "20",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "x",
