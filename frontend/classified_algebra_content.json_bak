        }
      },
      {
        "type": "string",
        "content": "is the slope of the graph of the equation in the",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "xy",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "-plane and",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(0 , b\\right)"
        }
      },
      {
        "type": "string",
        "content": "is the",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "y",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "-intercept. For the first equation,",
        "metadata": {
          "style": []
        }
