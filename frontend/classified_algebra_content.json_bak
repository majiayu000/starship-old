          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\$ 14"
        }
      },
      {
        "type": "string",
        "content": "for each additional person, the charge for the first",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "25"
        }
      },
      {
        "type": "string",
        "content": "people is",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\$ 21 \\left(\\right. 25 \\left.\\right)"
        }
      },
      {
        "type": "string",
        "content": "and the charge for the additional",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "n - 25"
        }
      },
      {
        "type": "string",
        "content": "people is",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\$ 14 \\left(\\right. n - 25 \\left.\\right)"
        }
      },
      {
        "type": "string",
        "content": ". Therefore, the total charge, in dollars, is given by the function",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "f \\left(\\right. n \\left.\\right) = 21 \\left(\\right. 25 \\left.\\right) + 14 \\left(\\right. n - 25 \\left.\\right)"
        }
      },
      {
        "type": "string",
        "content": ", or",
        "metadata": {
