        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "m = \\frac{- 4 - \\left(- 2\\right)}{0 - \\left(- 1\\right)}"
        }
      },
      {
        "type": "string",
        "content": ", which is equivalent to",
        "metadata": {
