      {
        "type": "string",
        "content": "y",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "in the second equation is equal to the coefficient of",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "y",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "in the first equation multiplied by 3. Therefore,",
        "metadata": {
          "style": []
        }
