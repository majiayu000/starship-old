        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "= 30. The price per adult ticket is $12, and the price per child ticket is $8. Since the theater received a total of $300 for the 30 tickets sold, it follows that 12",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "a",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "+ 8",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "c",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "= 300. To eliminate",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "c",
        "metadata": {
          "style": []
        }
      },
