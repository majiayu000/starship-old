      },
      {
        "type": "string",
        "content": "The graph of",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "y = f \\left(x\\right) + 14"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "is shown. Which equation defines function",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "f"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "?",
        "metadata": {
          "style": [
            "p"
          ],
          "content_type": "stem"
        }
      }
    ],
    "explanation": [
      {
        "type": "string",
        "content": "Choice A is correct. An equation for the graph shown can be written in slope-intercept form",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "y = m x + b"
        }
      },
      {
        "type": "string",
        "content": ", where",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "m"
        }
      },
      {
        "type": "string",
        "content": "is the slope of the graph and its",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "y",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "-intercept is",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(0 , b\\right)"
        }
      },
      {
        "type": "string",
        "content": ". Since the",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "y",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "-intercept of the graph shown is",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(0 , 2\\right)"
        }
      },
      {
        "type": "string",
        "content": ", the value of",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "b"
        }
      },
      {
        "type": "string",
        "content": "is",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "2"
        }
      },
      {
        "type": "string",
        "content": ". Since the graph also passes through the point",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(4 , 1\\right)"
        }
      },
      {
        "type": "string",
        "content": ", the slope can be calculated as",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\frac{1 - 2}{4 - 0}"
        }
      },
      {
        "type": "string",
        "content": ", or",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "- \\frac{1}{4}"
        }
      },
      {
        "type": "string",
        "content": ". Therefore, the value of",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "m"
        }
      },
      {
        "type": "string",
        "content": "is",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "- \\frac{1}{4}"
        }
      },
      {
        "type": "string",
        "content": ". Substituting",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "- \\frac{1}{4}"
        }
      },
      {
        "type": "string",
        "content": "for",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "m"
        }
      },
      {
        "type": "string",
        "content": "and",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "2"
        }
      },
      {
        "type": "string",
        "content": "for",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "b"
        }
      },
      {
        "type": "string",
        "content": "in the equation",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "y = m x + b"
        }
      },
      {
        "type": "string",
