          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "m = \\frac{y_{2} - y_{1}}{x_{2} - x_{1}}"
        }
      },
      {
        "type": "string",
        "content": ". Based on the table, the graph contains the points",
        "metadata": {
