        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "is a constant. The equation has no solution. What is the value of",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
