  {
    "url": "https://oneprep.xyz/question/309/?question_set=college-board-question-bank&module=math&primary_class=H&skill=H.C.",
    "question_set": "college-board-question-bank",
    "subject": "Math",
    "difficulty": "Medium",
    "domain": "Algebra",
    "skill": "Linear equations in two variables",
    "question_type": "fill",
    "question_content": [
      {
        "type": "string",
        "content": "What is the slope of the graph of",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "y = \\frac{1}{4} \\left(27 x + 15\\right) + 7 x"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "in the",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "xy",
        "metadata": {
          "style": [
            "em"
          ],
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "-plane?",
        "metadata": {
          "style": [
            "p"
          ],
          "content_type": "stem"
        }
      },
      {
        "type": "blank"
      }
    ],
    "explanation": [
      {
        "type": "string",
        "content": "The correct answer is",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\frac{55}{4}"
        }
      },
      {
        "type": "string",
        "content": ". In the",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "xy",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "-plane, the graph of an equation in the form",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "y = m x + b"
        }
      },
      {
        "type": "string",
        "content": ", where",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "m"
        }
      },
      {
        "type": "string",
        "content": "and",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "b"
        }
      },
      {
        "type": "string",
        "content": "are constants, has a slope of",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "m"
        }
      },
      {
        "type": "string",
        "content": "and a",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "y",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "-intercept of",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(0 , b\\right)"
        }
      },
      {
        "type": "string",
        "content": ". Applying the distributive property to the right-hand side of the given equation yields",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "y = \\frac{27}{4} x + \\frac{15}{4} + 7 x"
        }
      },
      {
        "type": "string",
        "content": ". Combining like terms yields",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "y = \\frac{55}{4} x + \\frac{15}{4}"
        }
      },
      {
        "type": "string",
        "content": ". This equation is in the form",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "y = m x + b"
        }
      },
      {
        "type": "string",
        "content": ", where",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "m = \\frac{55}{4}"
        }
      },
      {
        "type": "string",
        "content": "and",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "b = \\frac{15}{4}"
        }
      },
      {
        "type": "string",
        "content": ". It follows that the slope of the graph of",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "y = \\frac{1}{4} \\left(27 x + 15\\right) + 7 x"
        }
      },
      {
        "type": "string",
        "content": "in the",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "xy",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "-plane is",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\frac{55}{4}"
        }
      },
      {
        "type": "string",
        "content": ". Note that 55/4 and 13.75 are examples of ways to enter a correct answer.",
        "metadata": {
          "style": [
            "p"
          ]
        }
