  {
    "url": "https://oneprep.xyz/question/313/?question_set=college-board-question-bank&module=math&primary_class=H&skill=H.C.",
    "question_set": "college-board-question-bank",
    "subject": "Math",
    "difficulty": "Medium",
    "domain": "Algebra",
    "skill": "Linear equations in two variables",
    "question_type": "fill",
    "question_content": [
      {
        "type": "string",
        "content": "A line passes through the points",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(4 , 6\\right)"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "and",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(15 , 24\\right)"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "in the",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "xy",
        "metadata": {
          "style": [
            "em"
          ],
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "-plane. What is the slope of the line?",
        "metadata": {
          "style": [
            "p"
          ],
          "content_type": "stem"
        }
      },
      {
        "type": "blank"
      }
    ],
    "explanation": [
      {
        "type": "string",
        "content": "The correct answer is",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\frac{18}{11}"
        }
      },
      {
        "type": "string",
        "content": ". For a line that passes through the points",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(x_{1} , y_{1}\\right)"
        }
      },
      {
        "type": "string",
        "content": "and",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(x_{2} , y_{2}\\right)"
        }
      },
      {
        "type": "string",
        "content": "in the",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "xy",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "-plane, the slope of the line can be calculated using the slope formula,",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "m = \\frac{y_{2} - y_{1}}{x_{2} - x_{1}}"
        }
      },
      {
        "type": "string",
        "content": ". It's given that a line passes through the points",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(4 , 6\\right)"
        }
      },
      {
        "type": "string",
        "content": "and",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(15 , 24\\right)"
        }
      },
      {
        "type": "string",
        "content": "in the",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "xy",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "-plane. Substituting",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(4 , 6\\right)"
        }
      },
      {
        "type": "string",
        "content": "for",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(x_{1} , y_{1}\\right)"
        }
      },
      {
        "type": "string",
        "content": "and",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(15 , 24\\right)"
        }
      },
      {
        "type": "string",
        "content": "for",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(x_{2} , y_{2}\\right)"
        }
      },
      {
        "type": "string",
        "content": "in the slope formula,",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "m = \\frac{y_{2} - y_{1}}{x_{2} - x_{1}}"
        }
      },
      {
        "type": "string",
        "content": ", yields",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "m = \\frac{24 - 6}{15 - 4}"
        }
      },
      {
        "type": "string",
        "content": ", or",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "m = \\frac{18}{11}"
        }
      },
      {
        "type": "string",
        "content": ". Therefore, the slope of the line is",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\frac{18}{11}"
        }
      },
      {
        "type": "string",
        "content": ". Note that 18/11 and 1.636 are examples of ways to enter a correct answer.",
        "metadata": {
          "style": [
            "p"
          ]
        }
      }
    ],
    "answer": "1.636",
    "options": [],
