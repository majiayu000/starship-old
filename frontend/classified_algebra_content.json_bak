    "explanation": [
      {
        "type": "string",
        "content": "Choice C is correct. Adding the second equation of the given system to the first equation yields",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "5 x + \\left(- 4 x + y\\right) = 15 + \\left(- 2\\right)"
        }
      },
      {
        "type": "string",
        "content": ", which is equivalent to",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "x + y = 13"
        }
      },
      {
        "type": "string",
        "content": ". So the value of",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "x + y"
        }
      },
      {
        "type": "string",
        "content": "is",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "13"
        }
      },
      {
        "type": "string",
        "content": ".",
        "metadata": {
          "style": [
            "p"
          ]
        }
      },
      {
        "type": "string",
        "content": "Choice A is incorrect and may result from conceptual or calculation errors.",
        "metadata": {
          "style": [
            "p"
          ]
        }
      },
      {
        "type": "string",
        "content": "Choice B is incorrect. This is the value of",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "- \\left(\\right. x + y \\left.\\right)"
        }
      },
      {
        "type": "string",
        "content": ".",
        "metadata": {
          "style": [
            "p"
          ]
        }
      },
      {
        "type": "string",
        "content": "Choice D is incorrect and may result from conceptual or calculation errors.",
        "metadata": {
