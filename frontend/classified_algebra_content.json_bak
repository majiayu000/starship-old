    "question_content": [
      {
        "type": "figure",
        "content": "<figure class=\"table\"><table border=\"1\">\n<thead>\n<tr>\n<th scope=\"col\" style=\"width: 47.7651%; text-align: center;\"><math alttext=\"x\"><mi>x</mi>\n</math></th>\n<th scope=\"col\" style=\"width: 47.7651%; text-align: center;\"><math alttext=\"y\"><mi>y</mi>\n</math></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td style=\"width: 47.7651%; text-align: center;\"><math alttext=\"negative 18\"><mo>-</mo><mn>18</mn>\n</math></td>\n<td style=\"width: 47.7651%; text-align: center;\"><math alttext=\"negative 48\"><mo>-</mo><mn>48</mn>\n</math></td>\n</tr>\n<tr>\n<td style=\"width: 47.7651%; text-align: center;\"><math alttext=\"7\"><mn>7</mn>\n</math></td>\n<td style=\"width: 47.7651%; text-align: center;\"><math alttext=\"52\"><mn>52</mn>\n</math></td>\n</tr>\n</tbody>\n</table></figure>",
