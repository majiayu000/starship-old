    "explanation": [
      {
        "type": "string",
        "content": "Choice C is correct. An equation of a line can be written in the form",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "y = m x + b"
        }
      },
      {
        "type": "string",
        "content": ", where",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "m"
        }
      },
      {
        "type": "string",
        "content": "is the slope of the line and",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(0 , b\\right)"
        }
      },
      {
        "type": "string",
        "content": "is the",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "y",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "-intercept of the line. The line shown passes through the point",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(0 , - 8\\right)"
        }
      },
      {
        "type": "string",
        "content": ", so",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "b = - 8"
        }
      },
      {
        "type": "string",
        "content": ". The line shown also passes through the point",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(- 8 , 0\\right)"
        }
      },
      {
        "type": "string",
        "content": ". The slope,",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "m"
        }
      },
      {
        "type": "string",
        "content": ", of a line passing through two points",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(x_{1} , y_{1}\\right)"
        }
      },
      {
        "type": "string",
        "content": "and",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(x_{2} , y_{2}\\right)"
        }
      },
      {
        "type": "string",
        "content": "can be calculated using the equation",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "m = \\frac{y_{2} - y_{1}}{x_{2} - x_{1}}"
        }
      },
      {
        "type": "string",
        "content": ". For the points",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(0 , - 8\\right)"
        }
      },
      {
        "type": "string",
        "content": "and",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(- 8 , 0\\right)"
        }
      },
      {
        "type": "string",
        "content": ", this gives",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "m = \\frac{\\left(- 8\\right) - 0}{0 - \\left(- 8\\right)}"
        }
      },
      {
        "type": "string",
        "content": ", or",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "m = - 1"
        }
      },
      {
        "type": "string",
        "content": ". Substituting",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "- 8"
        }
      },
      {
        "type": "string",
        "content": "for",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "b"
        }
      },
      {
        "type": "string",
        "content": "and",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "- 1"
        }
      },
      {
        "type": "string",
        "content": "for",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "m"
        }
      },
      {
        "type": "string",
        "content": "in",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "y = m x + b"
        }
      },
      {
        "type": "string",
        "content": "yields",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "y = \\left(- 1\\right) x + \\left(- 8\\right)"
        }
      },
      {
        "type": "string",
        "content": ", or",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "y = - x - 8"
        }
      },
      {
        "type": "string",
        "content": ". Therefore, an equation of the graph shown is",
        "metadata": {
          "style": []
        }
