      {
        "type": "string",
        "content": "If a new graph of three linear equations is created using the system of equations shown and the equation",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "x + 4 y = - 16"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": ", how many solutions",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(x , y\\right)"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "will the resulting system of three equations have?",
        "metadata": {
          "style": [
            "p"
          ],
          "content_type": "stem"
        }
      }
    ],
    "explanation": [
      {
        "type": "string",
        "content": "Choice A is correct. A solution to a system of equations must satisfy each equation in the system. It follows that if an ordered pair",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(x , y\\right)"
        }
      },
      {
        "type": "string",
        "content": "is a solution to the system, the point",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(x , y\\right)"
        }
      },
      {
        "type": "string",
        "content": "lies on the graph in the",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "xy",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "-plane of each equation in the system. The only point that lies on each graph of the system of two linear equations shown is their intersection point",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(8 , 2\\right)"
        }
      },
      {
        "type": "string",
        "content": ".  It follows that if a new graph of three linear equations is created using the system of equations shown and the graph of",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "x + 4 y = - 16"
        }
      },
      {
        "type": "string",
        "content": ", this system has either zero solutions or one solution, the point",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(8 , 2\\right)"
        }
      },
      {
        "type": "string",
        "content": ". Substituting",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "8"
        }
      },
      {
        "type": "string",
        "content": "for",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "x"
        }
      },
      {
        "type": "string",
        "content": "and",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "2"
        }
      },
      {
        "type": "string",
        "content": "for",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "y"
        }
      },
      {
        "type": "string",
        "content": "in the equation",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "x + 4 y = - 16"
        }
      },
      {
        "type": "string",
        "content": "yields",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "8 + 4 \\left(2\\right) = - 16"
        }
      },
      {
        "type": "string",
        "content": ", or",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "16 = - 16"
        }
      },
      {
        "type": "string",
        "content": ". Since this equation is not true, the point",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(8 , 2\\right)"
        }
      },
      {
        "type": "string",
        "content": "does not lie on the graph of",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "x + 4 y = - 16"
        }
      },
      {
        "type": "string",
        "content": ". Therefore,",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(8 , 2\\right)"
        }
      },
      {
        "type": "string",
        "content": "is not a solution to the system of three equations. It follows that there are zero solutions to this system.",
        "metadata": {
          "style": [
            "p"
          ]
        }
      },
      {
        "type": "string",
        "content": "Choice B is incorrect and may result from conceptual or calculation errors.",
        "metadata": {
          "style": [
            "p"
          ]
        }
      },
      {
        "type": "string",
        "content": "Choice C is incorrect and may result from conceptual or calculation errors.",
        "metadata": {
          "style": [
            "p"
          ]
        }
      },
      {
        "type": "string",
        "content": "Choice D is incorrect and may result from conceptual or calculation errors.",
        "metadata": {
          "style": [
            "p"
          ]
        }
      }
    ],
    "answer": {
      "identifier": "A",
      "is_correct": true,
      "content": [
        {
          "type": "string",
          "content": "Zero",
          "metadata": {
            "style": [
              "p"
            ]
          }
        }
      ]
    },
    "options": [
      {
        "identifier": "A",
        "is_correct": true,
        "content": [
