      },
      {
        "type": "string",
        "content": ". It’s given that an equation for the graph shown is",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "y = f \\left(x\\right) + 14"
