          "type": "latex",
          "content": "3"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "pounds per day in its first year of life. This model is defined by an equation in the form",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "f \\left(x\\right) = a + b x"
