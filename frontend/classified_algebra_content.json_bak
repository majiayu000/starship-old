        }
      },
      {
        "type": "string",
        "content": ". It’s given that the graph shown is the graph of",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "y = f \\left(x\\right) - 11"
