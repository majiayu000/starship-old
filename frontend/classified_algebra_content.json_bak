    "explanation": [
      {
        "type": "string",
        "content": "Choice C is correct. It's given that there is a linear relationship between a plumber's hours of labor,",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "h"
