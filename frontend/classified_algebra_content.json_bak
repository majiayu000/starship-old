      },
      {
        "type": "string",
        "content": ", or",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "d = 60"
        }
      },
      {
        "type": "string",
        "content": ". Therefore, the bus will be",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "60"
        }
      },
      {
        "type": "string",
        "content": "feet from the marker",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "2"
        }
      },
      {
        "type": "string",
        "content": "seconds after passing it.",
        "metadata": {
          "style": [
            "p"
          ]
        }
      },
      {
        "type": "string",
        "content": "Choice A is incorrect. This is the distance, in feet, the bus will be from the marker",
        "metadata": {
