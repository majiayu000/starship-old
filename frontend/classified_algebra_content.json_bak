  {
    "url": "https://oneprep.xyz/question/141/?question_set=college-board-question-bank&module=math&primary_class=H&skill=H.E.",
    "question_set": "college-board-question-bank",
    "subject": "Math",
    "difficulty": "Hard",
    "domain": "Algebra",
    "skill": "Linear inequalities in one or two variables",
    "question_type": "fill",
    "question_content": [
      {
        "type": "string",
        "content": "A small business owner budgets",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\$ 2,200"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "to purchase candles. The owner must purchase a minimum of",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "200"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "candles to maintain the discounted pricing. If the owner pays",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\$ 4.90"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "per candle to purchase small candles and",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\$ 11.60"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "per candle to purchase large candles, what is the maximum number of large candles the owner can purchase to stay within the budget and maintain the discounted pricing?",
        "metadata": {
          "style": [
            "p"
          ],
          "content_type": "stem"
        }
      },
      {
        "type": "blank"
      }
    ],
    "explanation": [
      {
        "type": "string",
        "content": "The correct answer is",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "182"
        }
      },
      {
        "type": "string",
        "content": ". Let",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "s"
        }
      },
      {
        "type": "string",
        "content": "represent the number of small candles the owner can purchase, and let",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\mathcal{l}"
        }
      },
      {
        "type": "string",
        "content": "represent the number of large candles the owner can purchase. It’s given that the owner pays",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\$ 4.90"
        }
      },
      {
        "type": "string",
        "content": "per candle to purchase small candles and",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\$ 11.60"
        }
      },
      {
        "type": "string",
        "content": "per candle to purchase large candles. Therefore, the owner pays",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "4.90 s"
        }
      },
      {
        "type": "string",
        "content": "dollars for",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "s"
        }
      },
      {
        "type": "string",
        "content": "small candles and",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "11.60 \\mathcal{l}"
        }
      },
      {
        "type": "string",
        "content": "dollars for",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\mathcal{l}"
        }
      },
      {
        "type": "string",
        "content": "large candles, which means the owner pays a total of",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "4.90 s + 11.60 \\mathcal{l}"
        }
      },
      {
        "type": "string",
        "content": "dollars to purchase candles. It’s given that the owner budgets",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\$ 2,200"
        }
      },
      {
        "type": "string",
        "content": "to purchase candles. Therefore,",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "4.90 s + 11.60 \\mathcal{l} \\leq 2,200"
        }
      },
      {
        "type": "string",
        "content": ". It’s also given that the owner must purchase a minimum of",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "200"
        }
      },
