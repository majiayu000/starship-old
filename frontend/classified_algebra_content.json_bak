    "explanation": [
      {
        "type": "string",
        "content": "The question asks for the value of a constant in a quadratic equation. One method is to use the built-in calculator and plug in the answers. Enter the equation in an entry field, and then replace",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "c",
