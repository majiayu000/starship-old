        "content": ", where",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "m"
        }
      },
      {
        "type": "string",
        "content": "is the slope and",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(0 , b\\right)"
        }
      },
      {
        "type": "string",
        "content": "is the",
        "metadata": {
          "style": []
        }
      },
      {
