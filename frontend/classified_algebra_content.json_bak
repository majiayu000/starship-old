          "type": "base64",
          "content": "data:image/png;base64,",
          "style": [
            ""
          ]
        }
      },
      {
        "type": "string",
        "content": "dollars. The inequality",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "image",
        "content": {
          "type": "base64",
          "content": "data:image/png;base64,",
          "style": [
            ""
          ]
        }
      },
      {
        "type": "string",
        "content": "represents the condition that he will save at least $270 for the week. Factoring 10 out of the expression",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "image",
        "content": {
          "type": "base64",
          "content": "data:image/png;base64,",
          "style": [
            ""
          ]
        }
      },
      {
        "type": "string",
        "content": "gives",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "image",
        "content": {
          "type": "base64",
          "content": "data:image/png;base64,",
          "style": [
            ""
          ]
        }
      },
      {
        "type": "string",
        "content": ". The product of 10 and 0.9 is 9, so the inequality can be rewritten as",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "image",
        "content": {
          "type": "base64",
          "content": "data:image/png;base64,",
          "style": [
            ""
          ]
        }
      },
      {
        "type": "string",
        "content": ". Dividing both sides of this inequality by 9 yields",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "image",
        "content": {
          "type": "base64",
          "content": "data:image/png;base64,",
          "style": [
            ""
          ]
        }
      },
      {
        "type": "string",
        "content": ", so",
