      },
      {
        "type": "string",
        "content": "with each answer choice one at a time. When",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "c",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "= –20, there are two vertical lines indicating solutions to the equation. The question states that",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "the equation has no real solutions",
        "metadata": {
          "style": [
            "em"
          ]
