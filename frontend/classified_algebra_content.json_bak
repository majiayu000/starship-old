    "question_content": [
      {
        "type": "string",
        "content": "Maria plans to rent a boat. The boat rental costs $60 per hour, and she will also have to pay for a water safety course that costs $10. Maria wants to spend no more than $280 for the rental and the course. If the boat rental is available only for a whole number of hours, what is the maximum number of hours for which Maria can rent the boat?",
        "metadata": {
          "style": [
            "p"
          ],
          "content_type": "stem"
        }
      },
      {
        "type": "blank"
      }
    ],
    "explanation": [
      {
        "type": "string",
        "content": "The correct answer is 4. The equation",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "image",
        "content": {
          "type": "base64",
          "content": "data:image/png;base64,",
          "style": [
            ""
          ]
        }
      },
      {
        "type": "string",
        "content": ", where",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "h",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "is the number of hours the boat has been rented, can be written to represent the situation. Subtracting 10 from both sides and then dividing by 60 yields",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "image",
        "content": {
          "type": "base64",
          "content": "data:image/png;base64,",
          "style": [
            ""
          ]
        }
      },
      {
        "type": "string",
        "content": ". Since the boat can be rented only for whole numbers of hours, the maximum number of hours for which Maria can rent the boat is 4.",
        "metadata": {
          "style": [
            "p"
          ]
        }
      }
    ],
    "answer": "4",
