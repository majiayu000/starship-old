      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "x"
        }
      },
      {
        "type": "string",
        "content": "in the solution to the given system of equations, not the value of",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "y"
        }
      },
      {
        "type": "string",
        "content": ".",
