      {
        "type": "figure",
        "content": "<figure class=\"table\"><table border=\"1\">\n<thead>\n<tr>\n<th scope=\"col\" style=\"width: 47.6236%; text-align: center; vertical-align: bottom;\"><math alttext=\"h\"><mi>h</mi>\n</math></th>\n<th scope=\"col\" style=\"width: 47.7844%; text-align: center; vertical-align: bottom;\"><math alttext=\"f left parenthesis h right parenthesis\"><mi>f</mi><mfenced><mi>h</mi></mfenced></math></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td style=\"width: 47.6236%; text-align: center;\"><math alttext=\"1\"><mn>1</mn>\n</math></td>\n<td style=\"width: 47.7844%; text-align: center;\"><math alttext=\"155\"><mn>155</mn>\n</math></td>\n</tr>\n<tr>\n<td style=\"width: 47.6236%; text-align: center;\"><math alttext=\"3\"><mn>3</mn>\n</math></td>\n<td style=\"width: 47.7844%; text-align: center;\"><math alttext=\"285\"><mn>285</mn>\n</math></td>\n</tr>\n</tbody>\n</table></figure>",
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "There is a linear relationship between",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
