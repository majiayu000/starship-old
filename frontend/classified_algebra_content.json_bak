      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(x , y\\right)"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": ". What is the value of",
