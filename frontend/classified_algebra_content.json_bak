        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\$ 1"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": ". If Vivian bought",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "10"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "packages of party hats, how many cupcakes did she buy?",
        "metadata": {
          "style": [
            "p"
          ],
          "content_type": "stem"
        }
      },
      {
        "type": "blank"
      }
