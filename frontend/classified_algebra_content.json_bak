        "content": {
          "type": "latex",
          "content": "n - 25"
        }
      },
      {
        "type": "string",
        "content": "people. Since the museum charges",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\$ 21"
        }
      },
      {
        "type": "string",
        "content": "per person for the first",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "25"
        }
      },
      {
        "type": "string",
        "content": "people and",
