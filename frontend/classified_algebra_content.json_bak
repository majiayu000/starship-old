  {
    "url": "https://oneprep.xyz/question/11592/?question_set=college-board-question-bank&module=math&primary_class=H&skill=H.D.",
    "question_set": "college-board-question-bank",
    "subject": "Math",
    "difficulty": "Hard",
    "domain": "Algebra",
    "skill": "Systems of two linear equations in two variables",
    "question_type": "fill",
    "question_content": [
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\frac{7}{8} y - \\frac{5}{8} x = \\frac{4}{7} - \\frac{7}{8} y"
        },
        "metadata": {
          "style": [
            "p"
          ],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\frac{5}{4} x + \\frac{7}{4} = p y + \\frac{15}{4}"
        },
        "metadata": {
          "style": [
            "p"
          ],
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "In the given system of equations,",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "p"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "is a constant. If the system has no solution, what is the value of",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "p"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "?",
        "metadata": {
          "style": [
            "p"
          ],
          "content_type": "stem"
        }
      },
      {
        "type": "blank"
      }
    ],
    "explanation": [
      {
        "type": "string",
        "content": "The correct answer is",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\frac{7}{2}"
        }
      },
      {
        "type": "string",
        "content": ". A system of two linear equations in two variables,",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "x"
        }
      },
      {
        "type": "string",
        "content": "and",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "y"
        }
      },
      {
        "type": "string",
        "content": ", has no solution if the lines represented by the equations in the",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "xy",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "-plane are distinct and parallel. Two lines represented by equations in standard form",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "A x + B y = C"
        }
      },
      {
        "type": "string",
        "content": ", where",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "A"
        }
      },
      {
        "type": "string",
        "content": ",",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
