          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "of the A tiles and",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "b",
        "metadata": {
          "style": [
            "em"
          ],
          "content_type": "stem"
        }
      },
      {
        "type": "string",
