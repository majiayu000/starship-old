375 36.421875 \nQ 15.71875 36.421875 13.953125 34.765625 \nQ 12.203125 33.109375 11.234375 31.84375 \nQ 11.03125 31.84375 10.5 32.765625 \nQ 9.96875 33.6875 9.96875 34.078125 \nQ 10.546875 35.546875 14.59375 39.015625 \nQ 18.65625 42.484375 21.09375 42.484375 \nz\n\" id=\"CrimsonText-Italic-121\"></path>\n</defs>\n<g transform=\"translate(94.226012 22.350767)scale(0.15 -0.15)\">\n<use xlink:href=\"#CrimsonText-Italic-121\"></use>\n</g>\n</g>\n</g>\n<g id=\"text_35\">\n<g clip-path=\"url(#peef9f44f90)\">\n<!-- x -->\n<defs>\n<path d=\"M 20.3125 42.484375 \nQ 24.421875 42.484375 26.953125 33.984375 \nL 29 27.046875 \nL 34.765625 36.921875 \nQ 37.984375 42.484375 42.96875 42.484375 \nQ 46.296875 42.484375 48.640625 40.53125 \nQ 49.421875 38.96875 49.421875 37.984375 \nQ 49.421875 36.53125 48.390625 35.5 \nQ 47.359375 34.46875 46.296875 34.46875 \nQ 45.015625 34.46875 43.40625 35.984375 \nQ 41.796875 37.5 40.4375 37.5 \nQ 39.265625 37.5 37.796875 34.96875 \nL 30.46875 22.46875 \nL 34.671875 8.6875 \nQ 35.640625 5.375 37.3125 5.375 \nQ 38.765625 5.375 40.421875 6.890625 \nQ 42.09375 8.40625 42.78125 9.671875 \nQ 43.171875 9.671875 43.75 8.890625 \nQ 44.34375 8.109375 44.34375 7.71875 \nQ 44.046875 6.0625 40.71875 2.78125 \nQ 37.40625 -0.484375 34.375 -0.484375 \nQ 30.28125 -0.484375 27.734375 8.015625 \nL 25.484375 15.625 \nL 19.34375 4.984375 \nQ 16.109375 -0.59375 11.140625 -0.59375 \nQ 7.8125 -0.59375 5.46875 1.375 \nQ 4.6875 2.734375 4.6875 3.90625 \nQ 4.6875 5.375 5.703125 6.390625 \nQ 6.734375 7.421875 7.8125 7.421875 \nQ 9.078125 7.421875 10.6875 5.90625 \nQ 12.3125 4.390625 13.671875 4.390625 \nQ 14.84375 4.390625 16.3125 6.9375 \nL 24.03125 20.21875 \nL 20.015625 33.296875 \nQ 19.046875 36.625 17.390625 36.625 \nQ 15.921875 36.625 14.25 35.109375 \nQ 12.59375 33.59375 11.921875 32.328125 \nQ 11.53125 32.328125 10.9375 33.109375 \nQ 10.359375 33.890625 10.359375 34.28125 \nQ 10.640625 35.9375 13.953125 39.203125 \nQ 17.28125 42.484375 20.3125 42.484375 \nz\n\" id=\"CrimsonText-Italic-120\"></path>\n</defs>\n<g transform=\"translate(260.389509 193.213197)scale(0.15 -0.15)\">\n<use xlink:href=\"#CrimsonText-Italic-120\"></use>\n</g>\n</g>\n</g>\n<g id=\"line2d_1\">\n<path clip-path=\"url(#peef9f44f90)\" d=\"M 65.536082 254.314932 \nL 175.287394 34.812307 \nL 175.287394 34.812307 \n\" style=\"fill:none;stroke:#000000;stroke-linecap:square;stroke-width:2.3;\"></path>\n</g>\n<g id=\"line2d_2\">\n<path clip-path=\"url(#peef9f44f90)\" d=\"M 37.782876 85.002357 \nL 247.61393 189.917884 \nL 247.61393 189.917884 \n\" style=\"fill:none;stroke:#000000;stroke-linecap:square;stroke-width:2.3;\"></path>\n</g>\n</g>\n</g>\n<defs>\n<clippath id=\"peef9f44f90\">\n<rect height=\"260.82\" width=\"268.898496\" x=\"7.2\" y=\"7.2\"></rect>\n</clippath>\n</defs>\n</svg>\n<div aria-label=\"Long description for graph of a system of 2 lines\" class=\"sr-only\" role=\"region\"><ul><li>For the first line in the system:<br/>\n<ul>\n<li>The line slants gradually down from left to right.</li>\n<li>The line passes through the following points:<br/>\n<ul>\n<li>(0 comma 5)</li>\n<li>(2 comma 4)</li>\n<li>(10 comma 0)</li>\n</ul>\n</li>\n</ul>\n</li>\n<li>For the second line in the system:<br/>\n<ul>\n<li>The line slants sharply up from left to right.</li>\n<li>The line passes through the following points:<br/>\n<ul>\n<li>(0 comma 0)</li>\n<li>(2 comma 4)</li>\n<li>(5 comma 10)</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul></div></figure>",
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "The graph of a system of linear equations is shown. What is the solution",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(x , y\\right)"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "to the system?",
        "metadata": {
          "style": [
            "p"
          ],
          "content_type": "stem"
        }
      }
    ],
    "explanation": [
      {
        "type": "string",
        "content": "Choice B is correct. A solution to a system of equations must be the solution to each equation in the system. It follows that if",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(x , y\\right)"
        }
      },
      {
        "type": "string",
        "content": "is a solution to the system, the point",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(x , y\\right)"
        }
      },
      {
        "type": "string",
        "content": "lies on the graph in the",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "xy",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "-plane of each equation in the system. The point that lies on each graph of the system of linear equations shown is their intersection point",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(2 , 4\\right)"
        }
      },
      {
        "type": "string",
        "content": ". Therefore, the solution to the system is",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(2 , 4\\right)"
        }
      },
      {
        "type": "string",
        "content": ".",
