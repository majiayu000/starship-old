      {
        "identifier": "B",
        "is_correct": false,
        "content": [
          {
            "type": "string",
            "content": "Exactly one",
            "metadata": {
              "style": [
                "p"
              ]
            }
          }
        ]
      },
      {
        "identifier": "C",
        "is_correct": false,
        "content": [
          {
            "type": "string",
            "content": "Exactly two",
            "metadata": {
              "style": [
                "p"
              ]
