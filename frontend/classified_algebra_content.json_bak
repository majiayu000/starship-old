    "question_content": [
      {
        "type": "table",
        "content": "<table border=\"1\" style=\"width: 50%; border-collapse: collapse; margin-left: auto; margin-right: auto;\">\n<tbody>\n<tr>\n<td style=\"width: 50%; text-align: center;\">Time (seconds)</td>\n<td style=\"width: 50%; text-align: center;\">Number of colonies of yeast</td>\n</tr>\n<tr>\n<td style=\"width: 50%; text-align: center;\">0</td>\n<td style=\"width: 50%; text-align: center;\">5</td>\n</tr>\n<tr>\n<td style=\"width: 50%; text-align: center;\">1</td>\n<td style=\"width: 50%; text-align: center;\">20</td>\n</tr>\n<tr>\n<td style=\"width: 50%; text-align: center;\">2</td>\n<td style=\"width: 50%; text-align: center;\">80</td>\n</tr>\n<tr>\n<td style=\"width: 50%; text-align: center;\">3</td>\n<td style=\"width: 50%; text-align: center;\">320</td>\n</tr>\n</tbody>\n</table>",
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "The table above shows the exponential growth of a type of yeast over time",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "s",
        "metadata": {
