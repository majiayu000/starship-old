          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "4 \\left(4 x + 1\\right) = 15 x - 8"
        }
      },
      {
        "type": "string",
        "content": ". Applying the distributive property on the left-hand side of this equation yields",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "16 x + 4 = 15 x - 8"
        }
      },
      {
        "type": "string",
        "content": ". Subtracting",
        "metadata": {
          "style": []
        }
      },
      {
