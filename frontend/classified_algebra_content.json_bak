    "explanation": [
      {
        "type": "string",
        "content": "Choice D is correct. The linear relationship between",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "x"
        }
      },
      {
        "type": "string",
