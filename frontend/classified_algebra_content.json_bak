      },
      {
        "type": "string",
        "content": "yields",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "s \\geq 200 - \\mathcal{l}"
        }
      },
      {
        "type": "string",
        "content": ". Multiplying both sides of this inequality by",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "4.90"
        }
      },
      {
        "type": "string",
        "content": "yields",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "4.90 s \\geq 4.90 \\left(200 - \\mathcal{l}\\right)"
