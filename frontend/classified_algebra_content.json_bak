    "question_content": [
      {
        "type": "string",
        "content": "A contract for a certain service requires a onetime activation cost of",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\$ 35"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "and a monthly cost of",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\$ 23"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": ". Which equation represents this situation, where",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "c"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "is the total cost, in dollars, of this service contract for",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "t"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "months?",
        "metadata": {
          "style": [
            "p"
          ],
          "content_type": "stem"
        }
      }
    ],
    "explanation": [
      {
        "type": "string",
        "content": "Choice C is correct. It's given that this service contract requires a monthly cost of",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\$ 23"
        }
      },
      {
        "type": "string",
        "content": ". A monthly cost of",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\$ 23"
        }
      },
      {
        "type": "string",
        "content": "for",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "t"
        }
      },
      {
        "type": "string",
        "content": "months results in a cost of",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\$ 23 t"
        }
      },
      {
        "type": "string",
        "content": ". It's also given that this service contract requires a onetime activation cost of",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\$ 35"
        }
      },
      {
        "type": "string",
        "content": ". Adding the onetime activation cost to the monthly cost of the service contract for",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "t"
        }
      },
      {
        "type": "string",
        "content": "months yields the total cost",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "c"
        }
      },
      {
        "type": "string",
        "content": ", in dollars, of this service contract for",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "t"
        }
      },
      {
        "type": "string",
        "content": "months. Therefore, this situation can be represented by the equation",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "c = 23 t + 35"
        }
      },
      {
        "type": "string",
        "content": ".",
        "metadata": {
          "style": [
            "p"
          ]
        }
      },
