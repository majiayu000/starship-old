    "question_type": "fill",
    "question_content": [
      {
        "type": "string",
        "content": "Several tiles labeled with either an A or a B are placed in a bag, and tiles are worth a different point value depending on the label. The equation 15",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
