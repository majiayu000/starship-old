          ]
        }
      },
      {
        "type": "string",
        "content": "– 4) = 6",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "x",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "+ 20. Distribute on the left side of the equation to get 6",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "x",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "– 8 = 6",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "string",
        "content": "x",
        "metadata": {
          "style": [
            "em"
          ]
        }
      },
      {
        "type": "string",
        "content": "+ 20. Subtract 6",
        "metadata": {
          "style": []
