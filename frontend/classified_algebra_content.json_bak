          "content": "a"
        }
      },
      {
        "type": "string",
        "content": ",",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "b"
        }
      },
      {
        "type": "string",
        "content": ",",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "c"
        }
      },
