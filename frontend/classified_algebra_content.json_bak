        "type": "formula",
        "content": {
          "type": "latex",
          "content": "- 3 x + 5 y = 13"
        }
      },
      {
        "type": "string",
        "content": ". Dividing both sides of choice C by",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "4"
        }
