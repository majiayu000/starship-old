  {
    "url": "https://oneprep.xyz/question/11591/?question_set=college-board-question-bank&module=math&primary_class=H&skill=H.B.",
    "question_set": "college-board-question-bank",
    "subject": "Math",
    "difficulty": "Easy",
    "domain": "Algebra",
    "skill": "Linear functions",
    "question_type": "select",
    "question_content": [
      {
        "type": "string",
        "content": "To repair a refrigerator, a technician charges",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\$ 60"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "per hour for labor plus",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\$ 120"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "for parts. Which function",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "f",
        "metadata": {
          "style": [
            "em"
          ],
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "represents the total amount, in dollars, the technician will charge for this job if it takes",
        "metadata": {
          "style": [],
          "content_type": "stem"
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "x"
        },
        "metadata": {
          "content_type": "stem"
        }
      },
      {
        "type": "string",
        "content": "hours?",
        "metadata": {
          "style": [
            "p"
          ],
          "content_type": "stem"
        }
      }
    ],
    "explanation": [
      {
        "type": "string",
        "content": "Choice C is correct. It’s given that the technician charges",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\$ 60"
        }
      },
      {
        "type": "string",
        "content": "per hour for labor. Therefore, if the job takes",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "x"
        }
      },
      {
        "type": "string",
        "content": "hours, the technician will charge",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\left(\\frac{\\$ 60}{1 \\textrm{ }\\text{hour}}\\right) \\left(x \\text{hours}\\right)"
        }
      },
      {
        "type": "string",
        "content": ", or",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\$ 60 x"
        }
      },
      {
        "type": "string",
        "content": ", for labor. It’s also given that the technician charges",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "\\$ 120"
        }
      },
      {
        "type": "string",
        "content": "for parts. Therefore,",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "f \\left(x\\right) = 60 x + 120"
        }
      },
      {
        "type": "string",
        "content": "represents the total amount, in dollars, the technician will charge for this job if it takes",
        "metadata": {
          "style": []
        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "x"
        }
      },
      {
        "type": "string",
        "content": "hours.",
        "metadata": {
          "style": [
            "p"
          ]
        }
      },
      {
        "type": "string",
        "content": "Choice A is incorrect and may result from conceptual or calculation errors.",
        "metadata": {
          "style": [
            "p"
          ]
        }
      },
      {
        "type": "string",
        "content": "Choice B is incorrect. This function represents the total amount, in dollars, the technician charges for labor only, not the total amount charged for labor and parts.",
        "metadata": {
          "style": [
            "p"
          ]
        }
      },
      {
        "type": "string",
        "content": "Choice D is incorrect. This function represents the total amount, in dollars, the technician would charge if the charge for parts were subtracted from, rather than added to, the charge for labor.",
        "metadata": {
          "style": [
            "p"
          ]
        }
      }
    ],
    "answer": {
      "identifier": "C",
      "is_correct": true,
      "content": [
        {
          "type": "formula",
          "content": {
            "type": "latex",
            "content": "f \\left(x\\right) = 60 x + 120"
          },
          "metadata": {
            "style": [
              "p"
            ]
          }
        }
      ]
    },
    "options": [
      {
        "identifier": "A",
        "is_correct": false,
        "content": [
          {
            "type": "formula",
            "content": {
              "type": "latex",
              "content": "f \\left(x\\right) = x + 120"
            },
            "metadata": {
              "style": [
                "p"
              ]
            }
          }
        ]
      },
      {
        "identifier": "B",
        "is_correct": false,
        "content": [
          {
            "type": "formula",
            "content": {
              "type": "latex",
              "content": "f \\left(x\\right) = 60 x"
            },
            "metadata": {
              "style": [
                "p"
              ]
            }
          }
        ]
      },
      {
        "identifier": "C",
        "is_correct": true,
        "content": [
          {
            "type": "formula",
            "content": {
              "type": "latex",
              "content": "f \\left(x\\right) = 60 x + 120"
            },
            "metadata": {
              "style": [
                "p"
              ]
            }
          }
        ]
      },
      {
        "identifier": "D",
        "is_correct": false,
        "content": [
          {
            "type": "formula",
            "content": {
              "type": "latex",
              "content": "f \\left(x\\right) = 60 x - 120"
            },
            "metadata": {
              "style": [
                "p"
              ]
            }
          }
        ]
      }
    ],
