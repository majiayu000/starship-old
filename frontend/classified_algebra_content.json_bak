        }
      },
      {
        "type": "formula",
        "content": {
          "type": "latex",
          "content": "105"
        }
      },
      {
        "type": "string",
        "content": "feet below sea level.",
        "metadata": {
          "style": [
            "p"
          ]
        }
      },
      {
        "type": "string",
        "content": "Choice D is incorrect. This is the rate by which the pressure, in",
        "metadata": {
